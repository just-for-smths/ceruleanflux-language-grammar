{
  "$schema": "https://githubusercontent.com",
  "name": "CeruleanFlux",
  "scopeName": "source.ceruleanflux",
  "fileTypes": ["cflx"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#bytes" },
    { "include": "#strings" },
    { "include": "#characters" },
    { "include": "#booleans" },
    { "include": "#keywords" },
    { "include": "#numbers" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.documentation.ceruleanflux",
          "begin": "//:",
          "end": "$"
        },
        {
          "name": "comment.line.double-slash.ceruleanflux",
          "begin": "//",
          "end": "$"
        },
        {
          "name": "comment.block.documentation.ceruleanflux",
          "begin": "/-",
          "end": "-/",
          "patterns": [
            { "include": "#comments" }
          ]
        },
        {
          "name": "comment.block.ceruleanflux",
          "begin": "/\\*",
          "end": "\\*/",
          "patterns": [
            { "include": "#comments" }
          ]
        }
      ]
    },
    "bytes": {
      "patterns": [
        {
          "name": "string.quoted.double.bytes.ceruleanflux",
          "begin": "b\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.ceruleanflux",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.ceruleanflux",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.ceruleanflux",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "characters": {
      "patterns": [
        {
          "name": "string.quoted.single.character.ceruleanflux",
          "match": "'([^'\\\\]|\\\\.)'"
        }
      ]
    },
    "booleans": {
      "patterns": [
        {
          "name": "constant.language.boolean.ceruleanflux",
          "match": "\\b(true|false|nothing)\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.other.ceruleanflux",
          "match": "\\b(is|in|if|else|rpt|run|until|escape|skip|restart|noop|label|telpto|verify|ptm|return|flow|emit|detached|incomplete|flexible|finalized|changed|finished|self|struct|packed|enum|trait|adopts|masked|gen|use|bring|package|module|unbuffered|pinned|public|private|frozen|fixed|thawed|destroy|align|borrow|compare|case|other|fall|asm|as|from|with|guarantee|witness|always|later|pool|spawn|join|select|tunnel|isolated|share|when|excluding|decrease|unless|latent|vapor|transparent)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.ceruleanflux",
          "match": "\\b\\d+\\.\\d+\\b"
        },
        {
          "name": "constant.numeric.integer.ceruleanflux",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.operator.ceruleanflux",
          "match": "\\-\\->|<\\->|=>|<\\-|\\->|==|!=|>=|<=|\\+=|\\-=|\\*=|/=|%=|&=|\\|=|^=|\\*\\*|\\+\\+|\\-\\-|<<|>>|&&|\\|\\||>|<|=|\\+|\\-|\\*|/|%|&|\\||!|\\^|\\?"
        },
        {
          "name": "punctuation.symbols.ceruleanflux",
          "match": "\\.\\.\\.|\\[|\\]|\\{|\\}|\\(|\\)|,|:|#|\\.|\\$|~|@|`"
        }
      ]
    }
  }
}
